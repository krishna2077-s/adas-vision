function scenario_gen_{{ func_id }}()
% Auto-generated by ADAS Scenario Lab
% Scenario: {{ s.metadata.name }}
% Source:   {{ s.metadata.source }}
% DO NOT EDIT — regenerate via Scenario Lab

cfg = struct();
cfg.name  = '{{ s.metadata.name }}';
cfg.title = '{{ s.metadata.name }}';
cfg.mode  = '{{ s.ego_vehicle.mode }}';
cfg.dt    = {{ s.simulation_parameters.dt_s }};
cfg.max_time = {{ s.simulation_parameters.max_time_s }};
cfg.lane_half_width = {{ s.road.lane_half_width_m }};

cfg.ego_init.x       = {{ s.ego_vehicle.initial_x_m }};
cfg.ego_init.y       = {{ s.ego_vehicle.initial_y_m }};
cfg.ego_init.heading = deg2rad({{ s.ego_vehicle.initial_heading_deg }});
cfg.ego_init.speed   = {{ (s.ego_vehicle.initial_speed_kmh / 3.6)|round(4) }};

cfg.goal     = [{{ s.ego_vehicle.goal_x_m }}, {{ s.ego_vehicle.goal_y_m }}, 0];
cfg.goal_tol = {{ s.ego_vehicle.goal_tolerance_m }};

{% for actor in s.actors %}
act{{ loop.index }}.id     = '{{ actor.id }}';
act{{ loop.index }}.class  = '{{ actor.actor_class }}';
act{{ loop.index }}.x      = {{ actor.initial_x_m }};
act{{ loop.index }}.y      = {{ actor.initial_y_m }};
act{{ loop.index }}.vx     = {{ actor.initial_vx_mps }};
act{{ loop.index }}.vy     = {{ actor.initial_vy_mps }};
act{{ loop.index }}.width  = {{ actor.width_m }};
act{{ loop.index }}.length = {{ actor.length_m }};
{% endfor %}

cfg.actors = { {% for actor in s.actors %}act{{ loop.index }}{% if not loop.last %}, {% endif %}{% endfor %} };
cfg.update_actor = @(act, t, dt, ego) update_generated_actors(act, t, dt);
cfg.draw_background = @(ax) draw_generated_background(ax, cfg.lane_half_width, {{ s.road.length_m }});

scenario_result = adaptive_scenario_loop(cfg);
export_result_json(scenario_result, '{{ output_json_path }}');
end

function act = update_generated_actors(act, t, dt)
    switch act.id
{% for actor in s.actors %}
        case '{{ actor.id }}'
{% if actor.behaviour == 'static' %}
            % static
{% elif actor.behaviour == 'crossing' %}
            if t >= {{ actor.behaviour_trigger_s|default(0) }} && act.y < {{ actor.behaviour_y_target_m|default(3.5) }}
                act.x = act.x + act.vx * dt;
                act.y = act.y + act.vy * dt;
            end
{% elif actor.behaviour == 'sudden_stop' %}
            if t < {{ actor.behaviour_trigger_s|default(5) }}
                act.x = act.x + act.vx * dt;
                act.y = act.y + act.vy * dt;
            end
{% elif actor.behaviour == 'cut_in' %}
            act.x = act.x + act.vx * dt;
            if t >= {{ actor.behaviour_trigger_s|default(2) }} && abs(act.y) > 0.3
                act.y = act.y + act.vy * dt;
            end
{% else %}
            act.x = act.x + act.vx * dt;
            act.y = act.y + act.vy * dt;
{% endif %}
{% endfor %}
    end
end

function draw_generated_background(ax, lw, road_len)
    fill(ax, [0 road_len road_len 0], [-lw -lw lw lw], [0.22 0.22 0.24], 'EdgeColor', 'none');
    fill(ax, [0 road_len road_len 0], [-lw-4 -lw-4 -lw -lw], [0.15 0.28 0.12], 'EdgeColor', 'none');
    fill(ax, [0 road_len road_len 0], [lw lw lw+4 lw+4], [0.15 0.28 0.12], 'EdgeColor', 'none');
    plot(ax, [0 road_len], [0 0], 'w--', 'LineWidth', 0.8);
    plot(ax, [0 road_len], [-lw -lw], 'w-', 'LineWidth', 1.5);
    plot(ax, [0 road_len], [lw lw], 'w-', 'LineWidth', 1.5);
    ylim(ax, [-lw-5, lw+5]);
end
